.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Generated sample files (recreate them with scripts/generate_cur2_sample.py)
samples/*.csv
samples/*.parquet
samples/*.xlsx

# Requirements workbooks hold answers, which are kept privately in SharePoint or OneDrive.
# The one exception is the blank template, which holds the questions and no answers. The
# pre-commit hook refuses it once any answer is typed into it.
docs/*.xlsx
getbill-pipeline-questions*.xlsx
pipeline-questions*.xlsx
!docs/getbill-pipeline-questions.xlsx

# SSH folder and SSH keys
.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc

# AWS and other secret files
.aws/
credentials
.env
.env.*
*.secret
secrets.*
